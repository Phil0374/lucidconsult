---
const differentiators = [
  {
    title: "We speak human",
    text: "No AI buzzwords. No 50-slide decks. We explain AI the way you'd explain your business to a friend — clearly and honestly.",
    icon: "chat",
  },
  {
    title: "We price for SMBs",
    text: "We built this firm because enterprise consulting rates are absurd for a 30-person company. Our engagements start where they make sense for your P&L.",
    icon: "price",
  },
  {
    title: "We ship, not just advise",
    text: "Every recommendation comes with a working proof-of-concept. You see results before you commit. No vaporware, no slideware.",
    icon: "ship",
  },
  {
    title: "No vendor lock-in",
    text: "We recommend tools that fit your needs — not the ones that pay us commissions. We don't take vendor kickbacks. Period.",
    icon: "lock",
  },
];

const icons = {
  chat: '<path stroke-linecap="round" stroke-linejoin="round" d="M8.625 9.75a.375.375 0 11-.75 0 .375.375 0 01.75 0zm0 0H8.25m4.125 0a.375.375 0 11-.75 0 .375.375 0 01.75 0zm0 0H12m4.125 0a.375.375 0 11-.75 0 .375.375 0 01.75 0zm0 0h-.375m-13.5 3.01c0 1.6 1.123 2.994 2.707 3.227 1.087.16 2.185.283 3.293.369V21l4.184-4.183a1.14 1.14 0 01.778-.332 48.294 48.294 0 005.83-.498c1.585-.233 2.708-1.626 2.708-3.228V6.741c0-1.602-1.123-2.995-2.707-3.228A48.394 48.394 0 0012 3c-2.392 0-4.744.175-7.043.513C3.373 3.746 2.25 5.14 2.25 6.741v6.018z" />',
  price: '<path stroke-linecap="round" stroke-linejoin="round" d="M12 6v12m-3-2.818.879.659c1.171.879 3.07.879 4.242 0 1.172-.879 1.172-2.303 0-3.182C13.536 12.219 12.768 12 12 12c-.725 0-1.45-.22-2.003-.659-1.106-.879-1.106-2.303 0-3.182s2.9-.879 4.006 0l.415.33M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />',
  ship: '<path stroke-linecap="round" stroke-linejoin="round" d="M6 12 3.269 3.125A59.769 59.769 0 0121.485 12 59.768 59.768 0 013.27 20.875L5.999 12Zm0 0h7.5" />',
  lock: '<path stroke-linecap="round" stroke-linejoin="round" d="M16.5 10.5V6.75a4.5 4.5 0 10-9 0v3.75m-.75 11.25h10.5a2.25 2.25 0 002.25-2.25v-6.75a2.25 2.25 0 00-2.25-2.25H6.75a2.25 2.25 0 00-2.25 2.25v6.75a2.25 2.25 0 002.25 2.25z" />',
};
---

<section id="about" class="relative py-20 md:py-28">
  <div class="mx-auto max-w-6xl px-6">
    <div class="grid items-start gap-12 lg:grid-cols-2">
      <!-- Left -->
      <div class="reveal">
        <p class="text-xs font-semibold uppercase tracking-widest text-brand-400">About LucidConsult</p>
        <h2 class="mt-3 font-display text-3xl font-bold text-white md:text-4xl">The AI partner <span class="text-gradient">you wish existed</span></h2>
        <p class="mt-5 leading-relaxed text-ink-200">
          We started LucidConsult because small and mid-size businesses deserve better than what the AI industry offers them.
        </p>
        <p class="mt-4 leading-relaxed text-ink-200">
          Too many firms charge enterprise rates for slide decks. Too many vendors push tools you don't need. Too many "experts" can't
          explain AI in plain language. We exist to fix all three.
        </p>
        <p class="mt-4 leading-relaxed text-ink-200">
          We're based in Montréal, serving clients across North America. We're small by design — every client gets senior attention,
          not a junior consultant learning on your dime.
        </p>
      </div>

      <!-- Right: why us -->
      <div class="reveal grid gap-4 sm:grid-cols-2">
        {differentiators.map((d) => (
          <div class="glass rounded-2xl p-6">
            <div class="mb-3 flex h-10 w-10 items-center justify-center rounded-lg bg-brand-500/10 text-brand-400">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5" set:html={icons[d.icon]}/>
            </div>
            <h3 class="font-display text-sm font-semibold text-white">{d.title}</h3>
            <p class="mt-1.5 text-xs leading-relaxed text-ink-200">{d.text}</p>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>
