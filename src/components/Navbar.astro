---
import { t, type Lang } from "../i18n";
const { lang = "en" as Lang } = Astro.props;
const alt = lang === "en" ? "fr" : "en";
const links = [
  { href: "#why-ai", label: t(lang, "nav_why") },
  { href: "#services", label: t(lang, "nav_services") },
  { href: "#how", label: t(lang, "nav_how") },
  { href: "#about", label: t(lang, "nav_about") },
];
---

<header id="nav" class="fixed top-0 left-0 right-0 z-50 border-b border-white/5 bg-ink-950/85 backdrop-blur-xl transition-all">
  <div class="mx-auto flex max-w-6xl items-center justify-between px-6 py-4">
    <a href={lang === "fr" ? "/fr/#top" : "/#top"} class="flex items-center gap-2.5">
      <span class="flex h-9 w-9 items-center justify-center rounded-lg bg-gradient-to-br from-brand-400 to-brand-600 font-display text-lg font-bold text-ink-950">L</span>
      <span class="font-display text-lg font-semibold tracking-tight text-white">Lucid<span class="text-brand-400">Consult</span></span>
    </a>
    <div class="hidden items-center gap-8 md:flex">
      {links.map((l) => (
        <a href={l.href} class="text-sm font-medium text-ink-200 hover:text-white transition-colors">{l.label}</a>
      ))}
      <div class="h-5 w-px bg-white/15"></div>
      <a href={t(lang, "lang_url")} class="text-xs font-semibold uppercase tracking-wider text-ink-300 hover:text-brand-400 transition-colors">{t(lang, "lang_label")}</a>
      <a href="#contact" class="rounded-lg bg-brand-500 px-4 py-2 text-sm font-semibold text-white hover:bg-brand-600 transition-colors">{t(lang, "nav_contact")}</a>
    </div>
    <button id="menu-btn" class="flex h-10 w-10 items-center justify-center rounded-lg md:hidden text-white" aria-label="Menu">
      <svg id="menu-open" xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" d="M4 6h16M4 12h16M4 18h16"/></svg>
      <svg id="menu-close" xmlns="http://www.w3.org/2000/svg" class="hidden h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" d="M6 18 18 6M6 6l12 12"/></svg>
    </button>
  </div>
  <div id="mobile-menu" class="hidden border-t border-white/5 bg-ink-950/95 px-6 py-4 md:hidden">
    <div class="flex flex-col gap-4">
      {links.map((l) => (
        <a href={l.href} class="text-base font-medium text-ink-100">{l.label}</a>
      ))}
      <a href={t(lang, "lang_url")} class="text-base font-medium text-brand-400">{t(lang, "lang_label")}</a>
      <a href="#contact" class="rounded-lg bg-brand-500 px-4 py-2 text-center text-sm font-semibold text-white">{t(lang, "nav_contact")}</a>
    </div>
  </div>
</header>
<script>
  const btn = document.getElementById("menu-btn");
  const menu = document.getElementById("mobile-menu");
  const o = document.getElementById("menu-open");
  const c = document.getElementById("menu-close");
  btn.addEventListener("click", () => {
    const open = menu.classList.toggle("hidden");
    o.classList.toggle("hidden", !open);
    c.classList.toggle("hidden", open);
  });
  menu.querySelectorAll("a").forEach(a => a.addEventListener("click", () => {
    menu.classList.add("hidden"); o.classList.remove("hidden"); c.classList.add("hidden");
  }));
</script>
