---
import { t, type Lang } from "../i18n";
const { lang = "en" as Lang } = Astro.props;
const services = ["s1","s2","s3","s4","s5","s6"];
---

<section id="services" class="relative py-20 md:py-28">
  <div class="mx-auto max-w-6xl px-6">
    <div class="reveal mb-14 max-w-2xl">
      <p class="text-xs font-semibold uppercase tracking-widest text-brand-400">{t(lang, "services_badge")}</p>
      <h2 class="mt-3 font-display text-3xl font-bold text-white md:text-5xl" set:html={t(lang, "services_title")} />
      <p class="mt-4 text-lg text-ink-200">{t(lang, "services_subtitle")}</p>
    </div>

    <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
      {services.map((s) => (
        <div class="reveal glass rounded-2xl p-7 flex flex-col">
          <h3 class="font-display text-lg font-semibold text-white">{t(lang, `${s}_title`)}</h3>
          <p class="mt-3 flex-1 text-sm leading-relaxed text-ink-200">{t(lang, `${s}_desc`)}</p>
          <div class="mt-5 border-t border-white/5 pt-4">
            {[1,2,3].map((d) => (
              <div class="flex items-center gap-2 text-xs text-ink-300 mt-1.5">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5 flex-shrink-0 text-brand-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="m4.5 12.75 6 6 9-13.5"/></svg>
                {t(lang, `${s}_d${d}`)}
              </div>
            ))}
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
