---
const problems = [
  { title: "Too much manual work", text: "Your team spends hours on repetitive tasks — data entry, report generation, email routing — that AI can handle in seconds." },
  { title: "Vendor confusion", text: "Every software company says they do AI. How do you separate genuine tools from marketing fluff? We cut through it." },
  { title: "No internal AI expertise", text: "You can't afford a $200K data scientist. You don't need one. We bridge the gap with pragmatic, affordable guidance." },
  { title: "Fear of the wrong bet", text: "With 80% of AI projects failing, the risk of picking the wrong solution is real. We de-risk every decision with evidence and testing." },
];
---

<section id="why-ai" class="relative py-20 md:py-28">
  <div class="mx-auto max-w-6xl px-6">
    <div class="reveal mb-14 max-w-2xl">
      <p class="text-xs font-semibold uppercase tracking-widest text-brand-400">The Challenge</p>
      <h2 class="mt-3 font-display text-3xl font-bold text-white md:text-5xl">You know AI can help.<br/><span class="text-gradient">You just don't know where to start.</span></h2>
      <p class="mt-4 text-lg leading-relaxed text-ink-200">
        That's not a you problem — it's an industry problem. The AI landscape is noisy, expensive, and built for enterprises.
        We built LucidConsult to change that.
      </p>
    </div>

    <div class="grid gap-6 md:grid-cols-2">
      {problems.map((p) => (
        <div class="reveal glass rounded-2xl p-7">
          <div class="mb-4 flex h-10 w-10 items-center justify-center rounded-lg bg-brand-500/10 text-brand-400">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8"><path stroke-linecap="round" stroke-linejoin="round" d="M12 9v3.75m9-.75a9 9 0 11-18 0 9 9 0 0118 0Zm-9 3.75h.008v.008H12v-.008Z"/></svg>
          </div>
          <h3 class="font-display text-lg font-semibold text-white">{p.title}</h3>
          <p class="mt-2 text-sm leading-relaxed text-ink-200">{p.text}</p>
        </div>
      ))}
    </div>
  </div>
</section>
