---
import { t, type Lang } from "../i18n";
const { lang = "en" as Lang } = Astro.props;
const interestOptions = t(lang, "contact_interest_options").split(",");
---

<section id="contact" class="relative py-20 md:py-28">
  <div class="grid-bg absolute inset-0 opacity-30"></div>
  <div class="relative mx-auto max-w-6xl px-6">
    <div class="grid gap-12 lg:grid-cols-2">
      <div class="reveal">
        <p class="text-xs font-semibold uppercase tracking-widest text-brand-400">{t(lang, "contact_badge")}</p>
        <h2 class="mt-3 font-display text-3xl font-bold text-white md:text-5xl" set:html={t(lang, "contact_title")} />
        <p class="mt-4 max-w-md text-lg text-ink-200">{t(lang, "contact_subtitle")}</p>

        <div class="mt-8 space-y-4">
          <a href="mailto:info@lucidconsult.ai" class="flex items-center gap-4 text-ink-100 transition-colors hover:text-brand-400">
            <span class="flex h-11 w-11 items-center justify-center rounded-xl bg-brand-500/15 text-brand-400">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8"><path stroke-linecap="round" stroke-linejoin="round" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>
            </span>
            <span>
              <span class="block text-xs text-ink-300">{t(lang, "contact_email_label")}</span>
              <span class="font-medium">info@lucidconsult.ai</span>
            </span>
          </a>
          <div class="flex items-center gap-4 text-ink-100">
            <span class="flex h-11 w-11 items-center justify-center rounded-xl bg-brand-500/15 text-brand-400">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8"><path stroke-linecap="round" stroke-linejoin="round" d="M15 10.5a3 3 0 11-6 0 3 3 0 016 0z"/><path stroke-linecap="round" stroke-linejoin="round" d="M19.5 10.5c0 7.142-7.5 11.25-7.5 11.25S4.5 17.642 4.5 10.5a7.5 7.5 0 1115 0z"/></svg>
            </span>
            <span>
              <span class="block text-xs text-ink-300">{t(lang, "contact_location_label")}</span>
              <span class="font-medium">{t(lang, "contact_location")}</span>
            </span>
          </div>
        </div>
      </div>

      <div class="reveal glass rounded-2xl p-8 md:p-10">
        <form id="contact-form" class="space-y-5">
          <div class="grid gap-5 sm:grid-cols-2">
            <div>
              <label for="name" class="mb-1.5 block text-sm font-medium text-ink-100">{t(lang, "contact_name")}</label>
              <input id="name" name="name" type="text" required placeholder={t(lang, "contact_name_placeholder")}
                class="w-full rounded-lg border border-white/10 bg-ink-950/60 px-4 py-3 text-sm text-white placeholder-ink-400 outline-none transition-colors focus:border-brand-500"/>
            </div>
            <div>
              <label for="email" class="mb-1.5 block text-sm font-medium text-ink-100">{t(lang, "contact_email_field")}</label>
              <input id="email" name="email" type="email" required placeholder={t(lang, "contact_email_placeholder")}
                class="w-full rounded-lg border border-white/10 bg-ink-950/60 px-4 py-3 text-sm text-white placeholder-ink-400 outline-none transition-colors focus:border-brand-500"/>
            </div>
          </div>
          <div>
            <label for="company" class="mb-1.5 block text-sm font-medium text-ink-100">{t(lang, "contact_company")}</label>
            <input id="company" name="company" type="text" placeholder={t(lang, "contact_company_placeholder")}
              class="w-full rounded-lg border border-white/10 bg-ink-950/60 px-4 py-3 text-sm text-white placeholder-ink-400 outline-none transition-colors focus:border-brand-500"/>
          </div>
          <div>
            <label for="interest" class="mb-1.5 block text-sm font-medium text-ink-100">{t(lang, "contact_interest")}</label>
            <select id="interest" name="interest"
              class="w-full rounded-lg border border-white/10 bg-ink-950/60 px-4 py-3 text-sm text-white outline-none transition-colors focus:border-brand-500">
              {interestOptions.map((o) => <option value={o.trim()}>{o.trim()}</option>)}
            </select>
          </div>
          <div>
            <label for="message" class="mb-1.5 block text-sm font-medium text-ink-100">{t(lang, "contact_message")}</label>
            <textarea id="message" name="message" rows="4" required placeholder={t(lang, "contact_message_placeholder")}
              class="w-full resize-none rounded-lg border border-white/10 bg-ink-950/60 px-4 py-3 text-sm text-white placeholder-ink-400 outline-none transition-colors focus:border-brand-500"></textarea>
          </div>
          <button type="submit" class="w-full rounded-lg bg-brand-500 px-6 py-3.5 text-sm font-semibold text-white transition-all hover:bg-brand-600">
            {t(lang, "contact_submit")}
          </button>
          <p id="form-status" class="hidden rounded-lg px-4 py-3 text-sm font-medium"></p>
        </form>
      </div>
    </div>
  </div>
</section>

<div id="contact-msgs" data-success={t(lang, "contact_success")} data-error={t(lang, "contact_error")} data-net={t(lang, "contact_net_error")}></div>
<script>
  const form = document.getElementById("contact-form");
  const status = document.getElementById("form-status");
  const msgsEl = document.getElementById("contact-msgs");
  const msgs = {
    success: msgsEl?.dataset.success ?? "",
    error: msgsEl?.dataset.error ?? "",
    network: msgsEl?.dataset.net ?? "",
  };
  if (form) {
    form.addEventListener("submit", async (e) => {
      e.preventDefault();
      status.classList.add("hidden");
      const data = Object.fromEntries(new FormData(form).entries());
      try {
        const res = await fetch("/api/contact", { method: "POST", headers: { "Content-Type": "application/json" }, body: JSON.stringify(data) });
        const ok = res.ok;
        status.classList.remove("hidden");
        status.classList.toggle("bg-emerald-500/15 border border-emerald-400/30 text-emerald-300", ok);
        status.classList.toggle("bg-red-500/15 border border-red-400/30 text-red-300", !ok);
        status.textContent = ok ? msgs.success : msgs.error;
        if (ok) form.reset();
      } catch {
        status.classList.remove("hidden");
        status.classList.add("bg-red-500/15", "border", "border-red-400/30", "text-red-300");
        status.textContent = msgs.network;
      }
    });
  }
</script>
