---
import { t, type Lang } from "../i18n";
const { lang = "en" as Lang } = Astro.props;
const steps = ["how1","how2","how3","how4"];
---

<section id="how" class="relative py-20 md:py-28">
  <div class="absolute inset-0 bg-gradient-to-b from-transparent via-ink-950 to-transparent"></div>
  <div class="relative mx-auto max-w-6xl px-6">
    <div class="reveal mb-14 max-w-2xl">
      <p class="text-xs font-semibold uppercase tracking-widest text-brand-400">{t(lang, "how_badge")}</p>
      <h2 class="mt-3 font-display text-3xl font-bold text-white md:text-5xl" set:html={t(lang, "how_title")} />
      <p class="mt-4 text-lg text-ink-200">{t(lang, "how_subtitle")}</p>
    </div>

    <div class="relative grid gap-6 md:grid-cols-4">
      <div class="absolute top-8 left-0 right-0 hidden h-px bg-gradient-to-r from-transparent via-brand-400/20 to-transparent md:block"></div>

      {steps.map((s, i) => (
        <div class="reveal relative flex flex-col items-center text-center md:pt-8">
          <div class="relative z-10 flex h-16 w-16 items-center justify-center rounded-2xl bg-brand-500/15 text-brand-400 ring-4 ring-ink-950">
            <span class="font-display text-xl font-bold">{String(i+1).padStart(2,"0")}</span>
          </div>
          <h3 class="mt-5 font-display text-lg font-semibold text-white">{t(lang, `${s}_title`)}</h3>
          <p class="mt-2 text-sm leading-relaxed text-ink-200">{t(lang, `${s}_desc`)}</p>
        </div>
      ))}
    </div>
  </div>
</section>
