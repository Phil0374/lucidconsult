---
const steps = [
  { n: "01", title: "Listen & Learn", desc: "We spend real time understanding your business — how you work, what's broken, what matters. No assumptions, no templates." },
  { n: "02", title: "Map the Opportunity", desc: "We identify where AI makes the biggest difference for the least disruption. Ranked, costed, clear." },
  { n: "03", title: "Prove It", desc: "Before you commit, we run a small proof-of-concept. You see real results before spending real money." },
  { n: "04", title: "Build & Embed", desc: "We implement the solution, train your team, and stay close until it's running smoothly on its own." },
];
---

<section id="how" class="relative py-20 md:py-28">
  <div class="absolute inset-0 bg-gradient-to-b from-transparent via-ink-950 to-transparent"></div>
  <div class="relative mx-auto max-w-6xl px-6">
    <div class="reveal mb-14 max-w-2xl">
      <p class="text-xs font-semibold uppercase tracking-widest text-brand-400">How We Work</p>
      <h2 class="mt-3 font-display text-3xl font-bold text-white md:text-5xl">A process that<br/><span class="text-gradient">builds trust first</span></h2>
      <p class="mt-4 text-lg text-ink-200">We don't sell you a vision deck and disappear. We prove value early, build in the open, and earn your confidence at every step.</p>
    </div>

    <div class="relative grid gap-6 md:grid-cols-4">
      <!-- timeline line (desktop) -->
      <div class="absolute top-8 left-0 right-0 hidden h-px bg-gradient-to-r from-transparent via-brand-400/20 to-transparent md:block"></div>

      {steps.map((s) => (
        <div class="reveal relative flex flex-col items-center text-center md:pt-8">
          <div class="relative z-10 flex h-16 w-16 items-center justify-center rounded-2xl bg-brand-500/15 text-brand-400 ring-4 ring-ink-950">
            <span class="font-display text-xl font-bold">{s.n}</span>
          </div>
          <h3 class="mt-5 font-display text-lg font-semibold text-white">{s.title}</h3>
          <p class="mt-2 text-sm leading-relaxed text-ink-200">{s.desc}</p>
        </div>
      ))}
    </div>
  </div>
</section>
